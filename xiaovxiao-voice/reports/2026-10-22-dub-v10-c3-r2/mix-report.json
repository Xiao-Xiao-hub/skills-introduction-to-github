  "per_cue": [
    {
      "index": 1,
      "group": "01-02",
      "text": "躺下了。",
      "voice_rms": -10.231689063887806,
      "bed_rms": -20.186501674187586
    },
    {
      "index": 2,
      "group": "01-02",
      "text": "脑子却停不下来。",
      "voice_rms": -12.716007083488297,
      "bed_rms": -17.924428775142967
    },
    {
      "index": 3,
      "group": "03",
      "text": "一天里，许多念头冒出来，又慢慢散去。",
      "voice_rms": -14.984847751572076,
      "bed_rms": -18.67450522524665
    },
    {
      "index": 4,
      "group": "04",
      "text": "睡前，把明天要做的事，先写下来。",
      "voice_rms": -14.289525455380165,
      "bed_rms": -19.831218913007337
    },
    {
      "index": 5,
      "group": "05-06",
      "text": "这是晓念，从随手记下一句话开始。",
      "voice_rms": -13.063706634105717,
      "bed_rms": -20.329979170223776
    },
    {
      "index": 6,
      "group": "05-06",
      "text": "要做的事、没想完的问题，",
      "voice_rms": -12.978130675874555,
      "bed_rms": -15.434169101562334
    },
    {
      "index": 7,
      "group": "05-06",
      "text": "AI整理成卡，原话也一起留着。",
      "voice_rms": -11.15102528746078,
      "bed_rms": -16.510169488013084
    },
    {
      "index": 8,
      "group": "05-06",
      "text": "记下之后，再接着想。",
      "voice_rms": -12.624472855596398,
      "bed_rms": -17.083361807896228
    },
    {
      "index": 9,
      "group": "07",
      "text": "过几天，带着原话回来看，",
      "voice_rms": -10.525080481722275,
      "bed_rms": -15.825510935645301
    },
    {
      "index": 10,
      "group": "07",
      "text": "那件想报竞赛的事，现在怎么想？",
      "voice_rms": -12.281755691553277,
      "bed_rms": -16.33503212000077
    },
    {
      "index": 11,
      "group": "08",
      "text": "做完的待办勾掉，",
      "voice_rms": -8.665649552245181,
      "bed_rms": -17.237038144709558
    },
    {
      "index": 12,
      "group": "08",
      "text": "没想完的念头，留着继续。",
      "voice_rms": -16.20469289922403,
      "bed_rms": -15.966292741445065
    },
    {
      "index": 13,
      "group": "09",
      "text": "记录都在卡片墙上，",
      "voice_rms": -12.93562007806614,
      "bed_rms": -15.151868756147035
    },
    {
      "index": 14,
      "group": "09",
      "text": "想找回来时，不必从头翻。",
      "voice_rms": -13.171738906054545,
      "bed_rms": -18.0473766801217
    },
    {
      "index": 15,
      "group": "10",
      "text": "点“接着聊”，先看最担心的时间安排，",
      "voice_rms": -13.459682678009411,
      "bed_rms": -15.294727621468539
    },
    {
      "index": 16,
      "group": "10",
      "text": "再把顾虑一步步说清楚。",
      "voice_rms": -13.207280118968601,
      "bed_rms": -16.143434448461353
    },
    {
      "index": 17,
      "group": "11",
      "text": "聊出的新想法，先存成卡。",
      "voice_rms": -12.379400658638232,
      "bed_rms": -16.865090794707992
    },
    {
      "index": 18,
      "group": "11",
      "text": "再选几张相关的卡，一起看看。",
      "voice_rms": -13.675605379748557,
      "bed_rms": -17.681570891508656
    },
    {
      "index": 19,
      "group": "12",
      "text": "放进头脑风暴，分组、比较，",
      "voice_rms": -11.929203713677154,
      "bed_rms": -16.76897261572082
    },
    {
      "index": 20,
      "group": "12",
      "text": "找出这些念头之间的新联系。",
      "voice_rms": -15.868526357523084,
      "bed_rms": -16.689609165175074
    },
    {
      "index": 21,
      "group": "12",
      "text": "最后，把自己的结论写下来。",
      "voice_rms": -12.986157761558665,
      "bed_rms": -15.581991026300578
    },
    {
      "index": 22,
      "group": "13",
      "text": "一道极限题，卡在第一步。",
      "voice_rms": -14.16359824697723,
      "bed_rms": -17.92808915309221
    },
    {
      "index": 23,
      "group": "13",
      "text": "拍下来，先核对题目。",
      "voice_rms": -10.987111761429812,
      "bed_rms": -16.50994103378944
    },
    {
      "index": 24,
      "group": "14",
      "text": "先要一步提示，接着自己试算。",
      "voice_rms": -13.29135651188167,
      "bed_rms": -15.912025379519424
    },
    {
      "index": 25,
      "group": "14",
      "text": "相关研究中，直接给答案的那组，",
      "voice_rms": -13.074656871679313,
      "bed_rms": -17.256963871956373
    },
    {
      "index": 26,
      "group": "14",
      "text": "撤掉AI后表现下降。提示组未见明显下降。",
      "voice_rms": -12.372960412476587,
      "bed_rms": -16.289330977931424
    },
    {
      "index": 27,
      "group": "15",
      "text": "展开完整解析，还能查看计算核验。",
      "voice_rms": -12.23014508338412,
      "bed_rms": -16.455392320180607
    },
    {
      "index": 28,
      "group": "15",
      "text": "支持的算式，由程序重新计算。",
      "voice_rms": -12.716560197657369,
      "bed_rms": -16.935895322990284
    },
    {
      "index": 29,
      "group": "16",
      "text": "算完，把草稿拿来批改，",
      "voice_rms": -11.378796113377527,
      "bed_rms": -15.676309860108564
    },
    {
      "index": 30,
      "group": "16",
      "text": "定位出错步骤，再收进错题本。",
      "voice_rms": -14.01891813222187,
      "bed_rms": -19.611819426998284
    },
    {
      "index": 31,
      "group": "17",
      "text": "再把解题思路讲给小狸听。",
      "voice_rms": -12.549543190038337,
      "bed_rms": -19.38588353827049
    },
    {
      "index": 32,
      "group": "17",
      "text": "它会追问，再反馈哪些说清、哪些漏了。",
      "voice_rms": -12.421608698819666,
      "bed_rms": -18.381794333364706
    },
    {
      "index": 33,
      "group": "18",
      "text": "需要补充，就导入讲义。",
      "voice_rms": -12.544285453202782,
      "bed_rms": -17.968931202639418
    },
    {
      "index": 34,
      "group": "18",
      "text": "校对原文，再把相关段落整理成卡。",
      "voice_rms": -11.634124954001752,
      "bed_rms": -17.705859065626036
    },
    {
      "index": 35,
      "group": "19",
      "text": "最后，去知识地图独立做一道。",
      "voice_rms": -13.933381868279703,
      "bed_rms": -17.81933920792123
    },
    {
      "index": 36,
      "group": "19",
      "text": "先判断会不会，再作答看结果。",
      "voice_rms": -11.376220020677856,
      "bed_rms": -17.507174459420682
    },
    {
      "index": 37,
      "group": "20",
      "text": "累的时候，也可以只是聊聊。",
      "voice_rms": -12.617502286684985,
      "bed_rms": -17.829528572679166
    },
    {
      "index": 38,
      "group": "20",
      "text": "今天发生了什么，哪句话放不下，",
      "voice_rms": -13.819622956451546,
      "bed_rms": -19.42214941809104
    },
    {
      "index": 39,
      "group": "20",
      "text": "先把感受说出来。",
      "voice_rms": -13.592324542163114,
      "bed_rms": -19.75011974802808
    },
    {
      "index": 40,
      "group": "21",
      "text": "涉及安全风险，先提示现实中的求助。",
      "voice_rms": -15.021515635251617,
      "bed_rms": -18.187299971916538
    },
    {
      "index": 41,
      "group": "22",
      "text": "从记下一句，到自己想清楚，",
      "voice_rms": -16.041825179890775,
      "bed_rms": -17.707991653823054
    },
    {
      "index": 42,
      "group": "22",
      "text": "学习和回顾，都留在记录里。",
      "voice_rms": -15.774660950380675,
      "bed_rms": -17.154719658014653
    },
    {
      "index": 43,
      "group": "23a",
      "text": "刚才这些操作，由原生小程序发起。",
      "voice_rms": -14.918765341063956,
      "bed_rms": -15.778565738821644
    },
    {
      "index": 44,
      "group": "23a",
      "text": "后端通过接口处理请求，SQLite保存记录。",
      "voice_rms": -15.495369818738315,
      "bed_rms": -17.681173831370096
    },
    {
      "index": 45,
      "group": "23a",
      "text": "卡片、对话、导入和学习，各有业务模块。",
      "voice_rms": -14.498796125543027,
      "bed_rms": -17.941754901977724
    },
    {
      "index": 46,
      "group": "23b",
      "text": "接着聊，会带上选定卡片的相关上下文。",
      "voice_rms": -12.728891348381142,
      "bed_rms": -20.469267198544078
    },
    {
      "index": 47,
      "group": "23b",
      "text": "原话、生成内容和版本分开保存。",
      "voice_rms": -12.729120285789977,
      "bed_rms": -18.798946750960695
    },
    {
      "index": 48,
      "group": "23b",
      "text": "长任务先记状态，再执行；支持的算式另外核验。",
      "voice_rms": -13.905967833953927,
      "bed_rms": -18.291685409162902
    },
    {
      "index": 49,
      "group": "24",
      "text": "导入时离开，回来还能继续处理。",
      "voice_rms": -15.277728511430107,
      "bed_rms": -15.944708010529098
    },
    {
      "index": 50,
      "group": "24",
      "text": "外部调用集中在后端，异常时尝试备用接口。",
      "voice_rms": -14.75930240775881,
      "bed_rms": -17.508760224584616
    },
    {
      "index": 51,
      "group": "24",
      "text": "管理台查看任务、运行状态和反馈，",
      "voice_rms": -15.476603672436767,
      "bed_rms": -16.237396704362077
    },
    {
      "index": 52,
      "group": "24",
      "text": "并保留用量与操作记录。",
      "voice_rms": -15.039277480272501,
      "bed_rms": -17.060052185475122
    },
    {
      "index": 53,
      "group": "26-27",
      "text": "念，是转瞬的念头。",
      "voice_rms": -10.845816866742624,
      "bed_rms": -15.533751761437218
    },
    {
      "index": 54,
      "group": "26-27",
      "text": "晓，是让所想渐渐明了。",
      "voice_rms": -10.137394071241692,
      "bed_rms": -15.05115331140193
    },
    {
      "index": 55,
      "group": "26-27",
      "text": "晓念。",
      "voice_rms": -10.723416293172633,
      "bed_rms": -14.791445869484168
    }
  ],
  "human_listening": false
}
