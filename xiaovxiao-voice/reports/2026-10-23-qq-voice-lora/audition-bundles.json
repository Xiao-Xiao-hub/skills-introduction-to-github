    "segments": [
      {
        "id": "base_formal",
        "start_s": 0,
        "end_s": 5.92,
        "text": "这是晓念，想法可以先记下来，等有空的时候，再慢慢整理。"
      },
      {
        "id": "base_gentle",
        "start_s": 6.57,
        "end_s": 12.010000000000002,
        "text": "别着急，我们先把眼前这一步做好，剩下的，一起慢慢来。"
      },
      {
        "id": "base_bright",
        "start_s": 12.660000000000002,
        "end_s": 18.1,
        "text": "原来还可以这样！把零散的想法连起来，事情一下就清楚了。"
      },
      {
        "id": "base_continuity",
        "start_s": 18.75,
        "end_s": 30.59,
        "text": "作品介绍可以说得清楚，也可以保留一点真实的交流感。不必把每句话都念得一样整齐，关键的地方稍作停顿，让听的人跟得上，也愿意继续听下去。"
      }
    ],
    "between_sample_silence_s": 0.65,
    "within_sample_audio_unchanged": true
  },
