 "groups": [
  {
   "id": "01-02",
   "style": "语气平静，像讲一个熟悉的小瞬间，略带一点无奈",
   "lines": [
    {
     "shot": "01",
     "start": 0.35,
     "end": 1.55,
     "text": "躺下了。"
    },
    {
     "shot": "02",
     "start": 2.15,
     "end": 4.15,
     "text": "脑子却停不下来。"
    }
   ]
  },
  {
   "id": "03",
   "style": "自然地往前说，轻一点",
   "lines": [
    {
     "shot": "03",
     "start": 4.65,
     "end": 8.75,
     "text": "一天里，许多念头冒出来，又慢慢散去。"
    }
   ]
  },
  {
   "id": "04",
   "style": "平实，引出一个具体动作",
   "lines": [
    {
     "shot": "04",
     "start": 9.2,
     "end": 13.7,
     "text": "睡前，把明天要做的事，先写下来。"
    }
   ]
  },
  {
   "id": "05-06",
   "style": "带一点笑意，像介绍自己熟悉的工具",
   "lines": [
    {
     "shot": "05",
     "start": 14.18,
     "end": 17.6,
     "text": "这是晓念，从随手记下一句话开始。"
    },
    {
     "shot": "05",
     "start": 17.68,
     "end": 20.12,
     "text": "要做的事、没想完的问题，"
    },
    {
     "shot": "05",
     "start": 20.2,
     "end": 23.38,
     "text": "AI整理成卡，原话也一起留着。"
    },
    {
     "shot": "06",
     "start": 23.68,
     "end": 25.88,
     "text": "记下之后，再接着想。"
    }
   ]
  },
  {
   "id": "07",
   "style": "前半句回顾，后半句真诚地问",
   "lines": [
    {
     "shot": "07",
     "start": 26.18,
     "end": 28.41,
     "text": "过几天，带着原话回来看，"
    },
    {
     "shot": "07",
     "start": 28.49,
     "end": 31.38,
     "text": "那件想报竞赛的事，现在怎么想？"
    }
   ]
  },
  {
   "id": "08",
   "style": "干净利落，后半句放松",
   "lines": [
    {
     "shot": "08",
     "start": 31.68,
     "end": 33.58,
     "text": "做完的待办勾掉，"
    },
    {
     "shot": "08",
     "start": 33.66,
     "end": 36.38,
     "text": "没想完的念头，留着继续。"
    }
   ]
  },
  {
   "id": "09",
   "style": "平实地说明",
   "lines": [
    {
     "shot": "09",
     "start": 36.68,
     "end": 38.73,
     "text": "记录都在卡片墙上，"
    },
    {
     "shot": "09",
     "start": 38.81,
     "end": 41.38,
     "text": "想找回来时，不必从头翻。"
    }
   ]
  },
  {
   "id": "10",
   "style": "像在带人操作，清楚亲近",
   "lines": [
    {
     "shot": "10",
     "start": 41.68,
     "end": 46.12,
     "text": "点“接着聊”，先看最担心的时间安排，"
    },
    {
     "shot": "10",
     "start": 46.2,
     "end": 49.38,
     "text": "再把顾虑一步步说清楚。"
    }
   ]
  },
  {
   "id": "11",
   "style": "清楚利落",
   "lines": [
    {
     "shot": "11",
     "start": 49.68,
     "end": 52.01,
     "text": "聊出的新想法，先存成卡。"
    },
    {
     "shot": "11",
     "start": 52.09,
     "end": 54.88,
     "text": "再选几张相关的卡，一起看看。"
    }
   ]
  },
  {
   "id": "12",
   "style": "前面紧凑连贯，最后一句稍慢一点",
   "lines": [
    {
     "shot": "12",
     "start": 55.18,
     "end": 57.77,
     "text": "放进头脑风暴，分组、比较，"
    },
    {
     "shot": "12",
     "start": 57.85,
     "end": 60.95,
     "text": "找出这些念头之间的新联系。"
    },
    {
     "shot": "12",
     "start": 61.03,
     "end": 63.88,
     "text": "最后，把自己的结论写下来。"
    }
   ]
  },
  {
   "id": "13",
   "style": "先略带思考，再恢复干脆",
   "lines": [
    {
     "shot": "13",
     "start": 64.18,
     "end": 66.47,
     "text": "一道极限题，卡在第一步。"
    },
    {
     "shot": "13",
     "start": 66.55,
     "end": 68.38,
     "text": "拍下来，先核对题目。"
    }
   ]
  },
  {
   "id": "14",
   "style": "稳一些，清楚完整",
   "lines": [
    {
     "shot": "14",
     "start": 68.68,
     "end": 71.76,
     "text": "先要一步提示，接着自己试算。"
    },
    {
     "shot": "14",
     "start": 71.84,
     "end": 74.67,
     "text": "相关研究中，直接给答案的那组，"
    },
    {
     "shot": "14",
     "start": 74.75,
     "end": 79.38,
     "text": "撤掉AI后表现下降。提示组未见明显下降。"
    }
   ]
  },
  {
   "id": "15",
   "style": "稳而清楚，节奏略紧",
   "lines": [
    {
     "shot": "15",
     "start": 79.68,
     "end": 82.71,
     "text": "展开完整解析，还能查看计算核验。"
    },
    {
     "shot": "15",
     "start": 82.79,
     "end": 85.38,
     "text": "支持的算式，由程序重新计算。"
    }
   ]
  },
  {
   "id": "16",
   "style": "像帮人找出问题所在，温和",
   "lines": [
    {
     "shot": "16",
     "start": 85.68,
     "end": 88.09,
     "text": "算完，把草稿拿来批改，"
    },
    {
     "shot": "16",
     "start": 88.17,
     "end": 91.38,
     "text": "定位出错步骤，再收进错题本。"
    }
   ]
  },
  {
   "id": "17",
   "style": "亲近一点",
   "lines": [
    {
     "shot": "17",
     "start": 91.68,
     "end": 94.48,
     "text": "再把解题思路讲给小狸听。"
    },
    {
     "shot": "17",
     "start": 94.56,
     "end": 98.38,
     "text": "它会追问，再反馈哪些说清、哪些漏了。"
    }
   ]
  },
  {
   "id": "18",
   "style": "清楚自然",
   "lines": [
    {
     "shot": "18",
     "start": 98.68,
     "end": 100.88,
     "text": "需要补充，就导入讲义。"
    },
    {
     "shot": "18",
     "start": 100.96,
     "end": 104.38,
     "text": "校对原文，再把相关段落整理成卡。"
    }
   ]
  },
  {
   "id": "19",
   "style": "清楚平稳",
   "lines": [
    {
     "shot": "19",
     "start": 104.68,
     "end": 107.74,
     "text": "最后，去知识地图独立做一道。"
    },
    {
     "shot": "19",
     "start": 107.82,
     "end": 110.88,
     "text": "先判断会不会，再作答看结果。"
    }
   ]
  },
  {
   "id": "20",
   "style": "语速稍放松，柔和一点但清晰",
   "lines": [
    {
     "shot": "20",
     "start": 111.18,
     "end": 114.03,
     "text": "累的时候，也可以只是聊聊。"
    },
    {
     "shot": "20",
     "start": 114.11,
     "end": 117.48,
     "text": "今天发生了什么，哪句话放不下，"
    },
    {
     "shot": "20",
     "start": 117.56,
     "end": 119.38,
     "text": "先把感受说出来。"
    }
   ]
  },
  {
   "id": "21",
   "style": "沉稳简洁",
   "lines": [
    {
     "shot": "21",
     "start": 119.68,
     "end": 122.88,
     "text": "涉及安全风险，先提示现实中的求助。"
    }
   ]
  },
  {
   "id": "22",
   "style": "平稳地收束",
   "lines": [
    {
     "shot": "22",
     "start": 123.18,
     "end": 125.99,
     "text": "从记下一句，到自己想清楚，"
    },
    {
     "shot": "22",
     "start": 126.07,
     "end": 128.88,
     "text": "学习和回顾，都留在记录里。"
    }
   ]
  },
  {
   "id": "23a",
   "style": "清楚笃定，像开发者向评委说明实现",
   "lines": [
    {
     "shot": "23",
     "start": 129.18,
     "end": 132.54,
     "text": "刚才这些操作，由原生小程序发起。"
    },
    {
     "shot": "23",
     "start": 132.62,
     "end": 137.43,
     "text": "后端通过接口处理请求，SQLite保存记录。"
    },
    {
     "shot": "23",
     "start": 137.51,
     "end": 141.11,
     "text": "卡片、对话、导入和学习，各有业务模块。"
    }
   ]
  },
  {
   "id": "23b",
   "style": "清楚笃定，像开发者向评委说明实现",
   "lines": [
    {
     "shot": "23",
     "start": 141.19,
     "end": 145.03,
     "text": "接着聊，会带上选定卡片的相关上下文。"
    },
    {
     "shot": "23",
     "start": 145.11,
     "end": 148.24,
     "text": "原话、生成内容和版本分开保存。"
    },
    {
     "shot": "23",
     "start": 148.32,
     "end": 152.88,
     "text": "长任务先记状态，再执行；支持的算式另外核验。"
    }
   ]
  },
  {
   "id": "24",
   "style": "清楚笃定，最后语气略收",
   "lines": [
    {
     "shot": "24",
     "start": 153.18,
     "end": 156.6,
     "text": "导入时离开，回来还能继续处理。"
    },
    {
     "shot": "24",
     "start": 156.68,
     "end": 161.41,
     "text": "外部调用集中在后端，异常时尝试备用接口。"
    },
    {
     "shot": "24",
     "start": 161.49,
     "end": 165.17,
     "text": "管理台查看任务、运行状态和反馈，"
    },
    {
     "shot": "24",
     "start": 165.25,
     "end": 167.88,
     "text": "并保留用量与操作记录。"
    }
   ]
  },
  {
   "id": "26-27",
   "style": "比正文舒展一些，克制",
   "lines": [
    {
     "shot": "26",
     "start": 169.75,
     "end": 171.85,
     "text": "念，是转瞬的念头。"
    },
    {
     "shot": "26",
     "start": 172.12,
     "end": 174.35,
     "text": "晓，是让所想渐渐明了。"
    },
    {
     "shot": "27",
     "start": 175.35,
     "end": 176.25,
     "text": "晓念。"
    }
   ]
  }
 ]
